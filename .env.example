# =========================
# Google Analytics
# =========================
GA_MEASUREMENT_ID=G-XXXXXXX   # مثال، لا تستخدم القيمة الحقيقية

# =========================
# Facebook Pixel
# =========================
FB_PIXEL_ID=1234567890         # مثال

# =========================
# Amazon Affiliate IDs
# =========================
AMAZON_US=example-us           # مثال لأمريكا
AMAZON_CA=example-ca           # مثال لكندا
AMAZON_EG=example-eg           # مثال لمصر

# =========================
# MongoDB Connection String
# =========================
MONGODB_URI=mongodb+srv://username:password@cluster0.mongodb.net/dbname?retryWrites=true&w=majority
# <-- مثال، لا تستخدم البيانات الحقيقية

# =========================
# SerpApi Key
# =========================
SERPAPI_KEY=example_serpapi_key

# =========================
# Vercel Deployment
# =========================
VERCEL_TOKEN=example_vercel_token
VERCEL_PROJECT_ID=example_project_id
VERCEL_ORG_ID=example_org_id

# =========================
# أي مفاتيح سرية إضافية
# =========================
SECRET_KEY=example_secret_key
